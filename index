<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>打包费计算器 · 点数→费用</title>
<style>
:root{
  --bg1:#fff0f5; --bg2:#f3e8ff; --card:#ffffff;
  --accent:#e0558e; --accent2:#7c5cd6;
  --text:#37374d; --muted:#8e8ea3;
  --border:#f0dce8;
  --shadow:0 8px 28px rgba(224,85,142,.13);
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:"PingFang SC","Microsoft YaHei","Hiragino Sans GB",system-ui,sans-serif;
  background:linear-gradient(150deg,var(--bg1),var(--bg2));
  min-height:100vh;color:var(--text);padding:28px 14px 64px;
}
.wrap{max-width:760px;margin:0 auto}
header{text-align:center;margin-bottom:26px}
header .emoji{font-size:44px}
header h1{font-size:26px;color:var(--accent2);margin-top:6px}
header p{color:var(--muted);font-size:13.5px;margin-top:6px}
.card{
  background:var(--card);border-radius:18px;box-shadow:var(--shadow);
  border:1px solid var(--border);padding:20px 22px;margin-bottom:18px;
}
.card h2{font-size:16.5px;color:var(--accent2);margin-bottom:4px;display:flex;align-items:center;gap:8px}
.card .sub{font-size:12.5px;color:var(--muted);margin-bottom:14px}
/* 分段选择 */
.seg{display:flex;background:#f6f0fa;border-radius:12px;padding:4px;margin-bottom:16px;gap:4px}
.seg label{flex:1;text-align:center;padding:9px 0;border-radius:9px;font-size:14px;color:var(--muted);cursor:pointer;transition:.15s;user-select:none}
.seg input{display:none}
.seg input:checked + span{background:#fff;color:var(--accent2);font-weight:600;box-shadow:0 2px 8px rgba(124,92,214,.18)}
/* 输入行 */
.field{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 4px;border-bottom:1px dashed var(--border)}
.field:last-child{border-bottom:none}
.field .name{font-size:14.5px}
.field .name small{display:block;color:var(--muted);font-size:12px;margin-top:2px;font-weight:400}
.field .right{display:flex;align-items:center;gap:8px}
.field input[type=number]{
  width:86px;padding:8px 10px;border:1.5px solid var(--border);border-radius:10px;
  font-size:15px;text-align:center;outline:none;background:#fdf9fb;color:var(--text);
}
.field input[type=number]:focus{border-color:var(--accent);background:#fff}
.field .pts{font-size:13px;color:var(--accent2);font-weight:600;min-width:46px;text-align:right}
select{
  padding:7px 10px;border:1.5px solid var(--border);border-radius:10px;
  background:#fdf9fb;color:var(--text);font-size:13px;outline:none;cursor:pointer;
}
.items-total{margin-top:14px;text-align:center;font-size:14.5px;background:#fdf7fa;border:1px dashed var(--border);border-radius:12px;padding:10px}
.items-total b{color:var(--accent2);font-size:17px}
/* 结果区 */
.result{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
  background:linear-gradient(120deg,#fff0f6,#f4ecff);border:1.5px solid #f0d3e4;border-radius:16px;padding:18px 20px}
.result .left .label{font-size:13px;color:var(--muted)}
.result .left .big{font-size:34px;font-weight:800;color:var(--accent2);margin-top:2px}
.result .left .big span{font-size:15px;font-weight:600;color:var(--muted)}
.result .right .label{font-size:13px;color:var(--muted)}
.result .right .fee{font-size:40px;font-weight:800;color:var(--accent);margin-top:2px}
.result .right .fee span{font-size:16px}
.detail{margin-top:12px;font-size:13px;color:var(--muted);line-height:1.7}
.detail b{color:var(--accent2)}
/* 按钮 */
.actions{display:flex;gap:10px;margin-top:14px}
.btn{flex:1;border:none;border-radius:12px;padding:11px;font-size:14.5px;cursor:pointer;transition:.15s;font-weight:600}
.btn-primary{background:linear-gradient(120deg,var(--accent),var(--accent2));color:#fff}
.btn-primary:hover{filter:brightness(1.07)}
.btn-ghost{background:#f6f0fa;color:var(--accent2)}
.btn-ghost:hover{background:#efe6f8}
/* 表格 */
.table-scroll{max-height:320px;overflow:auto;border:1px solid var(--border);border-radius:12px}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th,td{padding:8px 10px;text-align:center;border-bottom:1px solid #f6eef2}
th{color:var(--muted);font-weight:600;background:#fdf7fa;position:sticky;top:0}
tbody tr.active{background:#fff0f6}
tbody tr.active td{color:var(--accent2);font-weight:700}
/* 规则 */
.rules{font-size:13.5px;line-height:2;color:#55556b}
.rules b{color:var(--accent2)}
/* toast */
.toast{position:fixed;left:50%;bottom:36px;transform:translateX(-50%) translateY(20px);
  background:#37374d;color:#fff;padding:10px 18px;border-radius:12px;font-size:13.5px;
  opacity:0;pointer-events:none;transition:.25s;z-index:9;max-width:90vw}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media(max-width:520px){
  .result .left .big{font-size:28px}
  .result .right .fee{font-size:32px}
  .field input[type=number]{width:76px}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="emoji">🎁</div>
    <h1>打包费计算器</h1>
    <p>先算点数，再算打包费 · 一步到位</p>
  </header>

  <!-- ① 计算点数 -->
  <div class="card">
    <h2>① 计算点数</h2>
    <div class="sub">选择一种方式得到总点数</div>
    <div class="seg">
      <label><input type="radio" name="mode" value="items" checked><span>按制品数量计算</span></label>
      <label><input type="radio" name="mode" value="direct"><span>直接输入点数</span></label>
    </div>

    <div id="items-panel">
      <div class="field">
        <div class="name">纸片 <small>每 5 张算 1 点（不满 5 张按 1 点算）</small></div>
        <div class="right">
          <input type="number" id="paper" min="0" step="1" value="0" inputmode="numeric">
          <span class="pts" id="paper-pts">= 0点</span>
        </div>
      </div>
      <div class="field">
        <div class="name">立牌 <small>每个算 1 点</small></div>
        <div class="right">
          <input type="number" id="standee" min="0" step="1" value="0" inputmode="numeric">
          <span class="pts" id="standee-pts">= 0点</span>
        </div>
      </div>
      <div class="field">
        <div class="name">文件夹 <small>每个算 3 点</small></div>
        <div class="right">
          <input type="number" id="folder" min="0" step="1" value="0" inputmode="numeric">
          <span class="pts" id="folder-pts">= 0点</span>
        </div>
      </div>
      <div class="field">
        <div class="name">其他制品 <small>每个算 1 点</small></div>
        <div class="right">
          <input type="number" id="other" min="0" step="1" value="0" inputmode="numeric">
          <span class="pts" id="other-pts">= 0点</span>
        </div>
      </div>
      <div class="items-total">制品合计点数：<b id="items-total">0</b> 点</div>
    </div>

    <div id="direct-panel" style="display:none">
      <div class="field">
        <div class="name">总点数 <small>直接输入具体点数</small></div>
        <div class="right">
          <input type="number" id="direct-points" min="0" step="1" value="0" inputmode="numeric">
          <span class="pts">点</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ② 打包费 -->
  <div class="card">
    <h2>② 打包费</h2>
    <div class="sub">0–9 点 0.5r，10–14 点 1r，之后每 5 点加 0.5r，上限 10r</div>
    <div class="result">
      <div class="left">
        <div class="label">总点数</div>
        <div class="big"><span id="result-points">0</span> <span>点</span></div>
      </div>
      <div class="right">
        <div class="label">打包费</div>
        <div class="fee"><span id="result-fee">0.5</span><span> r</span></div>
      </div>
    </div>
    <div class="detail" id="result-detail"></div>
    <div class="actions">
      <button class="btn btn-primary" id="copy-btn">📋 复制结果</button>
      <button class="btn btn-ghost" id="reset-btn">↺ 清空</button>
    </div>
  </div>

  <!-- ③ 费率表 -->
  <div class="card">
    <h2>③ 费率表</h2>
    <div class="sub">高亮行为当前点数所在档位</div>
    <div class="table-scroll">
      <table>
        <thead><tr><th>点数范围</th><th>打包费</th></tr></thead>
        <tbody id="fee-table"></tbody>
      </table>
    </div>
  </div>

  <!-- ④ 计算规则 -->
  <div class="card">
    <h2>📌 计算规则</h2>
    <div class="rules">
      <b>点数计算：</b><br>
      ・ 5 张纸片 = 1 点（不满 5 张按 1 点算）　・ 1 个立牌 = 1 点　・ 1 个文件夹 = 3 点　・ 其余制品 1 个 = 1 点<br>
      <b>打包费计算：</b><br>
      ・ 0–9 点 0.5r　・ 10–14 点 1r　・ 15–19 点 1.5r　・ 之后每 5 点加 0.5r<br>
      ・ 上限 10r
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const $ = id => document.getElementById(id);
const fields = { paper:$('paper'), standee:$('standee'), folder:$('folder'), other:$('other'), direct:$('direct-points') };

function intVal(el){ const v = parseInt(el.value, 10); return isNaN(v) || v < 0 ? 0 : v; }

function paperPts(){
  return Math.ceil(intVal(fields.paper) / 5);
}

function isDirect(){ return document.querySelector('input[name="mode"]:checked').value === 'direct'; }

function itemTotal(){
  return paperPts() + intVal(fields.standee) + intVal(fields.folder) * 3 + intVal(fields.other);
}

function getTotal(){ return isDirect() ? intVal(fields.direct) : itemTotal(); }

function calcFee(p){
  if (p <= 9) return 0.5;
  return Math.min(0.5 + 0.5 * Math.floor((p - 5) / 5), 10);
}

function fmt(n){ return String(Math.round(n * 10) / 10); }

/* 生成费率表 */
const rows = [];
rows.push({ r:'0 – 9 点', f:'0.5 r' });
let low = 10, fee = 1;
while (fee < 10){
  rows.push({ r: low + ' – ' + (low + 4) + ' 点', f: fmt(fee) + ' r' });
  low += 5; fee += 0.5;
}
rows.push({ r: low + ' 点及以上', f:'10 r（上限）' });

const tb = $('fee-table');
rows.forEach((row, i) => {
  const tr = document.createElement('tr');
  tr.innerHTML = '<td>' + row.r + '</td><td>' + row.f + '</td>';
  tr.dataset.i = i;
  tb.appendChild(tr);
});

function bracketIdx(p){
  if (p >= 100) return rows.length - 1;
  return p <= 9 ? 0 : Math.floor((p - 5) / 5);
}

function update(){
  const p = getTotal();
  const fee = calcFee(p);
  $('result-points').textContent = p;
  $('result-fee').textContent = fmt(fee);

  const idx = bracketIdx(p);
  const row = rows[idx];
  let detail;
  if (p >= 100){
    detail = '已达上限：打包费固定为 <b>10 r</b>';
  } else if (isDirect()){
    detail = '当前档位：<b>' + row.r + '</b> → 打包费 <b>' + row.f + '</b>';
  } else {
    detail = '纸片 <b>' + paperPts() + '</b>点 + 立牌 <b>' + intVal(fields.standee)
           + '</b>点 + 文件夹 <b>' + (intVal(fields.folder) * 3) + '</b>点 + 其他 <b>'
           + intVal(fields.other) + '</b>点 = <b>' + p + '</b> 点 → 档位 <b>' + row.r + '</b> → <b>' + row.f + '</b>';
  }
  $('result-detail').innerHTML = detail;

  Array.from(tb.children).forEach(tr => tr.classList.toggle('active', +tr.dataset.i === idx));

  $('paper-pts').textContent = '= ' + paperPts() + '点';
  $('standee-pts').textContent = '= ' + intVal(fields.standee) + '点';
  $('folder-pts').textContent = '= ' + (intVal(fields.folder) * 3) + '点';
  $('other-pts').textContent = '= ' + intVal(fields.other) + '点';
  $('items-total').textContent = itemTotal();
}

Object.values(fields).forEach(el => el.addEventListener('input', update));
document.querySelectorAll('input[name="mode"]').forEach(r => r.addEventListener('change', () => {
  const direct = isDirect();
  $('direct-panel').style.display = direct ? '' : 'none';
  $('items-panel').style.display = direct ? 'none' : '';
  update();
}));

/* 复制结果 */
$('copy-btn').addEventListener('click', () => {
  const p = $('result-points').textContent;
  const f = $('result-fee').textContent;
  const txt = '总点数 ' + p + ' 点，打包费 ' + f + ' r';
  const done = () => toast('已复制：' + txt);
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done).catch(() => fallbackCopy(txt, done));
  } else {
    fallbackCopy(txt, done);
  }
});
function fallbackCopy(txt, done){
  const ta = document.createElement('textarea');
  ta.value = txt; ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  document.execCommand('copy'); ta.remove(); done();
}

/* 清空 */
$('reset-btn').addEventListener('click', () => {
  Object.values(fields).forEach(el => el.value = 0);
  update();
});

function toast(msg){
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._h);
  t._h = setTimeout(() => t.classList.remove('show'), 2000);
}

update();
</script>
</body>
</html>
